# =============================================================================
# Elvin Ediz Immigration Services - Environment Configuration Template
# Copy this file to .env.local and populate with your actual keys.
# DO NOT commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Sanity Project & Dataset (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-14

# Studio Local Config
SANITY_STUDIO_PROJECT_ID=your_sanity_project_id
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Sanity API Tokens & Webhook Secrets (Server-Only / Private)
# -----------------------------------------------------------------------------
# Editor token with write permissions (used for live preview, form submissions, and CLI scripts)
SANITY_EDITOR_TOKEN=your_sanity_editor_token

# CLI & Dataset export token (used for Sanity CLI deploys & GitHub Action backups)
SANITY_AUTH_TOKEN=your_sanity_auth_token

# Secret key configured in Sanity Webhook for on-demand cache revalidation (/api/revalidate)
SANITY_REVALIDATE_SECRET=your_revalidation_secret

# -----------------------------------------------------------------------------
# 3. Application & Website URLs
# -----------------------------------------------------------------------------
# Production site domain (used for canonical URLs, OpenGraph social cards, and sitemaps)
NEXT_PUBLIC_SITE_URL=https://elvinediz.com

# Optional external webhook to trigger notifications on new consultation appointments
APPOINTMENT_WEBHOOK_URL=
