{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elvin-ediz-newsroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "kv_namespaces": [{ "binding": "NEWS_CACHE", "id": "REPLACE_AFTER_CREATING_KV" }],
  "triggers": { "crons": ["15 6 * * *"] },
  "vars": {
    "SANITY_PROJECT_ID": "REPLACE_WITH_PROJECT_ID",
    "SANITY_DATASET": "production",
    "ALLOWED_ORIGINS": "https://your-studio.sanity.studio,https://your-site.pages.dev",
  },
}
